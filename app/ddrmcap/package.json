{
  "name": "ddrmcap",
  "version": "0.0.1",
  "description": "DDRM Cap",
  "keywords": [
    "ui5",
    "openui5",
    "sapui5"
  ],
  "main": "webapp/index.html",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9",
    "@sap/ux-ui5-tooling": "^1.20.3",
    "@ui5/cli": "^4.0.16",
    "ui5-middleware-simpleproxy": "^3.6.2",
    "ui5-task-zipper": "^3"
  },
  "scripts": {
    "deploy-config": "npx -p @sap/ux-ui5-tooling fiori add deploy-config cf",
    "build": "ui5 build preload --clean-dest --config ui5-deploy.yaml",
    "build-local": "ui5 build preload --clean-dest",
    "start": "ui5 serve",
    "postbuild": "cp xs-app.json dist/xs-app.json"
  },
  "ui5": {
    "dependencies": [
      "ui5-task-zipper"
    ]
  }
}
