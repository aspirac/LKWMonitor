{
  "name": "ddrm",
  "version": "1.0.0",
  "description": "DDRM Cap.",
  "dependencies": {
    "@cap-js/attachments": "^3.13.1",
    "@cap-js/change-tracking": "^1.1.3",
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.6.0",
    "@sap-cloud-sdk/http-client": "^4.6.0",
    "@sap-cloud-sdk/resilience": "^4.6.0",
    "@sap/approuter": "^22.0.1",
    "@sap/cds": "^9.4.4",
    "@sap/html5-repo-mock": "^2.2.1",
    "@sap/textbundle": "^6.2.0",
    "@sap/xssec": "^4",
    "axion": "^0.1.0",
    "axios": "^1.18.0",
    "cfenv": "^1.2.6",
    "express": "^4.22.2",
    "hana": "^0.0.2"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds-dk": "^9.8.4",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.34",
    "rimraf": "^5.0.10"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-ddrm": "cds watch --open ddrm/index.html?sap-ui-xx-viewCache=false --livereload false",
    "build": "cds build --production",
    "watch:hybrid": "cds watch --profile hybrid",
    "deploy:hana": "cds build && cds deploy --to hana:lx11628-t2a-vpt-hdi-pag-dev-target-to-achieve",
    "build:cf": "rimraf ./gen && npm run build && npm run build:ui:ddrm",
    "build:ui:ddrm": "cd app/ddrmcap && npm install && npm run build",
    "deploy:btp:dev": "mbt build && cf deploy mta_archives/ddrm_1.0.0.mtar"
  },
  "engines": {
    "node": "24.15.0",
    "npm": "11.17.0"
  },
  "cds": {
    "requires": {
      "change-tracking": {
        "considerLocalizedValues": true
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "testvv": {
            "password": "test",
            "roles": [
              "LKWViewer"
            ]
          },
          "attachments": {
            "scan": true
          },
          "test": {
            "password": "test",
            "roles": [
              "LKWManager"
            ]
          }
        }
      },
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        }
      },
      "[production]": {
        "db": "hana",
        "auth": {
          "kind": "xsuaa"
        }
      },
      "[hybrid]": {
        "db": {
          "kind": "hana"
        }
      },
      "html5-repo": true,
      "portal": false,
      "destinations": true,
      "workzone": true
    },
    "fiori": {
      "preview": true
    },
    "server": {
      "index": true
    }
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/ddrm"
  ]
}
